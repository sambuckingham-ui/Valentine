<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#0b0b10" />
  <title>Mrs. Buckingham — Be My Valentine?</title>

  <!-- Optional: pretty fonts (works best when opened via a link/hosted) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">

  <style>
    :root{
      --bg:#0b0b10;
      --card:#12121b;
      --card2:#0f0f17;
      --pink:#ff4da6;
      --hotpink:#ff2d95;
      --soft:#ffd1e8;
      --text:#f3f3f7;
      --muted:#c9c9d4;
      --shadow: 0 20px 60px rgba(0,0,0,.55);
      --ring: 0 0 0 2px rgba(255,77,166,.35), 0 0 40px rgba(255,77,166,.15);
      --radius: 20px;
    }

    *{ box-sizing:border-box; }
    html,body{ height:100%; }
    body{
      margin:0;
      color:var(--text);
      background:
        radial-gradient(1200px 600px at 70% -10%, rgba(255,77,166,.18), transparent 55%),
        radial-gradient(900px 500px at 20% 10%, rgba(255,45,149,.10), transparent 60%),
        radial-gradient(900px 500px at 50% 110%, rgba(255,77,166,.10), transparent 60%),
        linear-gradient(180deg, #07070c 0%, var(--bg) 55%, #07070c 100%);
      font-family: Poppins, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
      overflow-x:hidden;
    }

    /* subtle gothic “lace” */
    .lace {
      position:fixed; inset:-60px;
      pointer-events:none;
      opacity:.10;
      filter: blur(.2px);
      background-image:
        radial-gradient(circle at 12px 12px, rgba(255,77,166,.35) 2px, transparent 3px),
        radial-gradient(circle at 36px 36px, rgba(255,77,166,.25) 2px, transparent 3px);
      background-size: 48px 48px;
      transform: rotate(-7deg);
      mask-image: radial-gradient(circle at 50% 50%, rgba(0,0,0,.9), transparent 70%);
    }

    .wrap{
      min-height:100%;
      display:flex;
      align-items:center;
      justify-content:center;
      padding: 22px 16px 30px;
    }

    .card{
      width:min(940px, 100%);
      background: linear-gradient(180deg, rgba(18,18,27,.92), rgba(12,12,18,.90));
      border: 1px solid rgba(255,77,166,.18);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow:hidden;
      position:relative;
    }

    .topbar{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      padding: 18px 18px 0;
    }

    .badge{
      display:inline-flex;
      align-items:center;
      gap:10px;
      padding:10px 14px;
      border-radius:999px;
      background: rgba(255,77,166,.10);
      border: 1px solid rgba(255,77,166,.20);
      box-shadow: 0 0 0 1px rgba(255,77,166,.05) inset;
      color: var(--soft);
      font-size: 12px;
      letter-spacing:.12em;
      text-transform:uppercase;
      user-select:none;
      white-space:nowrap;
    }

    .badge .dot{
      width:8px;height:8px;border-radius:99px;
      background: var(--pink);
      box-shadow: 0 0 18px rgba(255,77,166,.7);
    }

    .content{
      display:grid;
      grid-template-columns: 1.05fr .95fr;
      gap: 18px;
      padding: 16px 18px 18px;
    }

    @media (max-width: 860px){
      .content{ grid-template-columns: 1fr; }
      .topbar{ padding-top: 16px; }
    }

    .left{
      padding: 14px 14px 10px;
    }

    h1{
      font-family: Cinzel, Georgia, "Times New Roman", serif;
      margin: 10px 0 10px;
      font-size: clamp(34px, 4.2vw, 58px);
      line-height:1.05;
      letter-spacing:.02em;
    }
    .sub{
      margin: 0 0 16px;
      color: var(--muted);
      font-size: 15px;
      line-height:1.55;
      max-width: 62ch;
    }

    .quote{
      margin: 16px 0 18px;
      padding: 14px 14px 14px 16px;
      border-left: 3px solid rgba(255,77,166,.75);
      background: rgba(255,77,166,.07);
      border-radius: 14px;
      color: #f6f0f4;
    }
    .quote p{ margin: 8px 0; }
    .quote strong{ color: var(--soft); }

    .buttons{
      display:flex;
      flex-wrap:wrap;
      gap: 10px;
      margin-top: 16px;
    }

    .btn{
      appearance:none;
      border: 1px solid rgba(255,77,166,.28);
      background: rgba(255,77,166,.10);
      color: var(--text);
      padding: 12px 14px;
      border-radius: 14px;
      font-weight: 600;
      letter-spacing:.02em;
      cursor:pointer;
      transition: transform .12s ease, background .18s ease, border-color .18s ease;
      box-shadow: 0 0 0 1px rgba(255,77,166,.06) inset;
      user-select:none;
    }
    .btn:active{ transform: translateY(1px); }
    .btn.primary{
      background: linear-gradient(180deg, rgba(255,77,166,.95), rgba(255,45,149,.85));
      border-color: rgba(255,77,166,.65);
      color: #120914;
      box-shadow: 0 10px 30px rgba(255,77,166,.22);
    }
    .btn.primary:hover{ filter: brightness(1.02); }
    .btn:hover{ background: rgba(255,77,166,.14); border-color: rgba(255,77,166,.42); }
    .btn:focus{ outline:none; box-shadow: var(--ring); }

    .right{
      padding: 14px 14px 16px;
    }

    .gallery{
      background: linear-gradient(180deg, rgba(15,15,23,.92), rgba(10,10,16,.92));
      border: 1px solid rgba(255,77,166,.16);
      border-radius: var(--radius);
      padding: 12px;
      position:relative;
      overflow:hidden;
    }

    .frame{
      border-radius: 16px;
      overflow:hidden;
      aspect-ratio: 4 / 5;
      position:relative;
      background: rgba(0,0,0,.35);
    }

    .slide{
      position:absolute; inset:0;
      opacity:0;
      transform: scale(1.03);
      transition: opacity .6s ease, transform .9s ease;
      background-size: cover;
      background-position: center;
      filter: contrast(1.02) saturate(1.05);
    }
    .slide.active{
      opacity:1;
      transform: scale(1.0);
    }

    .gallery .caption{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap: 10px;
      margin-top: 10px;
      color: var(--muted);
      font-size: 13px;
    }

    .dots{ display:flex; gap:7px; align-items:center; }
    .dot{
      width: 8px; height: 8px; border-radius: 99px;
      background: rgba(255,77,166,.25);
      border: 1px solid rgba(255,77,166,.25);
      cursor:pointer;
    }
    .dot.active{ background: var(--pink); box-shadow: 0 0 14px rgba(255,77,166,.5); }

    .footer{
      padding: 0 18px 18px;
      color: rgba(201,201,212,.85);
      font-size: 12px;
      display:flex;
      justify-content:space-between;
      gap:10px;
      flex-wrap:wrap;
    }

    .sig{
      font-family: Cinzel, Georgia, "Times New Roman", serif;
      letter-spacing:.05em;
      color: rgba(255,209,232,.95);
    }

    /* modal */
    .modal{
      position:fixed; inset:0;
      display:none;
      place-items:center;
      background: rgba(5,5,8,.72);
      backdrop-filter: blur(6px);
      padding: 18px;
      z-index: 50;
    }
    .modal.show{ display:grid; }
    .modalCard{
      width:min(640px, 100%);
      background: linear-gradient(180deg, rgba(18,18,27,.98), rgba(10,10,16,.96));
      border: 1px solid rgba(255,77,166,.24);
      border-radius: 22px;
      box-shadow: var(--shadow);
      padding: 18px 18px 16px;
      text-align:center;
      position:relative;
      overflow:hidden;
    }
    .modalCard h2{
      margin: 6px 0 8px;
      font-family: Cinzel, Georgia, serif;
      font-size: clamp(26px, 4vw, 38px);
    }
    .modalCard p{
      margin: 0 auto 14px;
      color: var(--muted);
      line-height:1.55;
      max-width: 56ch;
    }
    .plan{
      margin: 12px auto 16px;
      padding: 12px 14px;
      border-radius: 16px;
      background: rgba(255,77,166,.08);
      border: 1px solid rgba(255,77,166,.18);
      color: #f6f0f4;
      max-width: 56ch;
      text-align:left;
    }
    .plan strong{ color: var(--soft); }

    /* hearts confetti canvas */
    #confetti{
      position:fixed; inset:0;
      pointer-events:none;
      z-index: 60;
    }

    @media (prefers-reduced-motion: reduce){
      .slide, .btn{ transition:none !important; }
    }
  </style>
</head>

<body>
  <canvas id="confetti"></canvas>
  <div class="lace" aria-hidden="true"></div>

  <main class="wrap">
    <section class="card" role="region" aria-label="Valentine page">
      <div class="topbar">
        <div class="badge"><span class="dot"></span> Romantic • Gothic-cute</div>
        <div class="badge">For: <span style="letter-spacing:.02em;text-transform:none;color:var(--soft);margin-left:4px;">Mrs. Buckingham</span></div>
      </div>

      <div class="content">
        <div class="left">
          <h1>Mrs. Buckingham,<br>will you be my Valentine?</h1>

          <p class="sub">
            From <strong>Mr. Buckingham</strong> — the guy who still gets lucky enough to call you mine.
            I wanted something simple, a little dark-cute, and very us.
          </p>

          <div class="quote">
            <p>❤️ <strong>I love how you’re there for me through everything.</strong></p>
            <p>❤️ <strong>I love that you’re an amazing mom to our children.</strong></p>
            <p>❤️ <strong>I love that you’re always honest and real.</strong></p>
          </div>

          <p class="sub">
            So… one more time, and always:
            <strong>be my Valentine?</strong>
          </p>

          <div class="buttons">
            <button class="btn primary" id="yesBtn">Yes 💗</button>
            <button class="btn" id="alsoYesBtn">Absolutely yes 🖤</button>
          </div>
        </div>

        <div class="right">
          <div class="gallery" aria-label="Photo gallery">
            <div class="frame">
              <!-- IMPORTANT: put these image files in the same folder as this HTML -->
              <div class="slide active" style="background-image:url('photo1.jpg')" aria-hidden="true"></div>
              <div class="slide" style="background-image:url('photo2.jpg')" aria-hidden="true"></div>
              <div class="slide" style="background-image:url('photo3.jpg')" aria-hidden="true"></div>
            </div>

            <div class="caption">
              <span id="capText">Our favorites ✨</span>
              <div class="dots" aria-label="Slideshow dots">
                <div class="dot active" data-i="0" role="button" tabindex="0" aria-label="Photo 1"></div>
                <div class="dot" data-i="1" role="button" tabindex="0" aria-label="Photo 2"></div>
                <div class="dot" data-i="2" role="button" tabindex="0" aria-label="Photo 3"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="footer">
        <div>🖤 + 💗</div>
        <div class="sig">— Mr. Buckingham</div>
      </div>
    </section>
  </main>

  <!-- “YES” modal -->
  <div class="modal" id="modal" role="dialog" aria-modal="true" aria-label="Valentine accepted">
    <div class="modalCard">
      <h2>Yay. It’s a date. 💗</h2>
      <p>
        You’re my favorite person — and I’m still choosing you, every single day.
      </p>

      <div class="plan">
        <div><strong>Tonight’s plan:</strong></div>
        <div>• Quiet night at home</div>
        <div>• I’ll cook dinner</div>
        <div>• Cuddle up together (no distractions)</div>
      </div>

      <button class="btn primary" id="closeBtn">Okay, Valentine 🖤</button>
    </div>
  </div>

  <script>
    // ---------- Slideshow ----------
    const slides = Array.from(document.querySelectorAll('.slide'));
    const dots = Array.from(document.querySelectorAll('.dot'));
    const capText = document.getElementById('capText');
    const captions = ["Our favorites ✨", "Us being cute 😌", "My forever date 🖤"];

    let idx = 0;
    function show(i){
      idx = i;
      slides.forEach((s, n) => s.classList.toggle('active', n === i));
      dots.forEach((d, n) => d.classList.toggle('active', n === i));
      capText.textContent = captions[i] || "Our favorites ✨";
    }

    let timer = setInterval(() => show((idx + 1) % slides.length), 4500);

    function dotClick(i){
      clearInterval(timer);
      show(i);
      timer = setInterval(() => show((idx + 1) % slides.length), 4500);
    }

    dots.forEach(d => {
      d.addEventListener('click', () => dotClick(Number(d.dataset.i)));
      d.addEventListener('keydown', (e) => {
        if(e.key === 'Enter' || e.key === ' ') dotClick(Number(d.dataset.i));
      });
    });

    // ---------- Modal + Confetti ----------
    const modal = document.getElementById('modal');
    const yesBtn = document.getElementById('yesBtn');
    const alsoYesBtn = document.getElementById('alsoYesBtn');
    const closeBtn = document.getElementById('closeBtn');

    function openModal(){
      modal.classList.add('show');
      startHeartConfetti();
    }
    function closeModal(){
      modal.classList.remove('show');
    }

    yesBtn.addEventListener('click', openModal);
    alsoYesBtn.addEventListener('click', openModal);
    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => { if(e.target === modal) closeModal(); });

    // ---------- Heart confetti (canvas) ----------
    const canvas = document.getElementById('confetti');
    const ctx = canvas.getContext('2d');

    function resize(){
      const dpr = Math.max(1, window.devicePixelRatio || 1);
      canvas.width = Math.floor(window.innerWidth * dpr);
      canvas.height = Math.floor(window.innerHeight * dpr);
      canvas.style.width = window.innerWidth + "px";
      canvas.style.height = window.innerHeight + "px";
      ctx.setTransform(dpr,0,0,dpr,0,0);
    }
    window.addEventListener('resize', resize);
    resize();

    let particles = [];
    let animId = null;
    let endAt = 0;

    function rand(min, max){ return Math.random() * (max - min) + min; }

    function heartPath(x, y, s){
      ctx.beginPath();
      const topCurveHeight = s * 0.3;
      ctx.moveTo(x, y + topCurveHeight);
      ctx.bezierCurveTo(x, y, x - s/2, y, x - s/2, y + topCurveHeight);
      ctx.bezierCurveTo(x - s/2, y + (s + topCurveHeight)/2, x, y + (s + topCurveHeight)/1.2, x, y + s);
      ctx.bezierCurveTo(x, y + (s + topCurveHeight)/1.2, x + s/2, y + (s + topCurveHeight)/2, x + s/2, y + topCurveHeight);
      ctx.bezierCurveTo(x + s/2, y, x, y, x, y + topCurveHeight);
      ctx.closePath();
    }

    function spawnHearts(count){
      for(let i=0;i<count;i++){
        particles.push({
          x: rand(0, window.innerWidth),
          y: rand(window.innerHeight * 0.2, window.innerHeight),
          vy: rand(-4.8, -2.2),
          vx: rand(-1.2, 1.2),
          rot: rand(0, Math.PI*2),
          vr: rand(-0.06, 0.06),
          size: rand(10, 18),
          alpha: rand(0.65, 1),
          life: rand(70, 120),
          color: Math.random() < 0.55 ? "#ff4da6" : "#ffd1e8"
        });
      }
    }

    function tick(){
      ctx.clearRect(0,0,window.innerWidth, window.innerHeight);

      particles.forEach(p => {
        p.x += p.vx;
        p.y += p.vy;
        p.rot += p.vr;
        p.vy += 0.04; // gravity
        p.life -= 1;
        p.alpha *= 0.992;

        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rot);
        ctx.globalAlpha = Math.max(0, p.alpha);
        ctx.fillStyle = p.color;
        heartPath(0, 0, p.size);
        ctx.fill();
        ctx.restore();
      });

      particles = particles.filter(p => p.life > 0 && p.alpha > 0.05 && p.y < window.innerHeight + 80);

      const now = Date.now();
      if(now < endAt){
        // keep feeding a little
        if(Math.random() < 0.65) spawnHearts(6);
        animId = requestAnimationFrame(tick);
      } else {
        // fade out cleanly
        if(particles.length > 0){
          animId = requestAnimationFrame(tick);
        } else {
          cancelAnimationFrame(animId);
          animId = null;
          ctx.clearRect(0,0,window.innerWidth, window.innerHeight);
        }
      }
    }

    function startHeartConfetti(){
      endAt = Date.now() + 2200;
      spawnHearts(60);
      if(!animId) tick();
    }
  </script>
</body>
</html>
